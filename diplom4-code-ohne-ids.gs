    if(it.completed!==true||it.exampleSeen!==true)throw new Error('Modul '+module.number+' ist nicht vollständig bearbeitet.');
    if(typeof it.answer!=='string'||!it.answer.trim()||it.answer.length>4000)throw new Error('Die Erklärung in Modul '+module.number+' fehlt.');
    if(!it.choice||it.choice.picked!==ex.choiceCorrect)throw new Error('Die Auswahlfrage in Modul '+module.number+' ist nicht richtig beantwortet.');
    if(![0,1,2].includes(it.selfcheck))throw new Error('Der Lerncheck in Modul '+module.number+' fehlt.');
